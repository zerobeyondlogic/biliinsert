{
  "manifest_version": 3,
  "name": "B站属地补全",
  "version": "0.2.3",
  "description": "以 B站原生文字风格补全评论、楼中楼、主页与动态的 IP 属地，并显示关注时间。",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://app.bilibili.com/*",
    "https://passport.bilibili.com/*"
  ],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "B站属地补全"},
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_scripts": [
    {
      "matches": ["https://space.bilibili.com/*", "https://t.bilibili.com/*", "https://www.bilibili.com/*"],
      "js": ["comments-main.js"], "run_at": "document_start", "world": "MAIN"
    },
    {
      "matches": ["https://space.bilibili.com/*", "https://t.bilibili.com/*", "https://www.bilibili.com/*"],
      "js": ["comments-content.js"], "run_at": "document_start"
    },
    {
      "matches": ["https://space.bilibili.com/*"],
      "js": ["subscribe-time-main.js"], "run_at": "document_start", "world": "MAIN"
    },
    {
      "matches": ["https://space.bilibili.com/*"],
      "js": ["subscribe-time-content.js"], "run_at": "document_start"
    },
    {
      "matches": ["https://space.bilibili.com/*", "https://t.bilibili.com/*", "https://www.bilibili.com/*"],
      "js": ["main.js"], "run_at": "document_idle", "world": "MAIN"
    },
    {
      "matches": ["https://space.bilibili.com/*", "https://t.bilibili.com/*", "https://www.bilibili.com/*"],
      "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"
    }
  ]
}
